# Copy to .env and adjust. Never commit real secrets.

DATABASE_URL="sqlserver://localhost:1433;database=beacon;user=sa;password=Beacon%2123456;encrypt=true;trustServerCertificate=true"
AUTH_SECRET="replace-with-a-32-byte-hex-secret"
AUTH_URL="http://localhost:3000"

# S3-compatible storage (MinIO locally, AWS S3 in production)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="beacon-attachments"
S3_ACCESS_KEY="beacon"
S3_SECRET_KEY="beaconbeacon"
S3_FORCE_PATH_STYLE="true"

# SMTP (Mailpit locally, SES in production)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Beacon <noreply@beacon.local>"

REDIS_URL="redis://localhost:6379"

# Optional: public app URL used in emails
APP_URL="http://localhost:3000"
NODE_ENV="development"
